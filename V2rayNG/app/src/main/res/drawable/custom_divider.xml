<!-- Full-bleed hairline divider for the server list (0.0.22 polish).
     1px tall (height: 0.5dp can render as 0 on lower densities, 1dp reads
     as a single hairline on all densities). Slightly indented from the
     start so it lines up with where remark text begins, but flush to the
     end so the eye doesn't catch a hanging gap on the right edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="14dp"
        android:right="0dp"
        android:top="0dp">
        <shape>
            <size android:height="1dp" />
            <solid android:color="@color/colorRowDivider" />
        </shape>
    </item>
</layer-list>
